# dotSafehouse config, sourced by bin/safe (POSIX sh syntax, shell-agnostic).
# Runs agents under eugene1g/agent-safehouse with a chosen feature set,
# plus an extra deny layer for SSH keys, cloud creds, Keychains, Slack,
# and 1Password app state.

export DOTSAFEHOUSE_APPEND="$HOME/.config/dotSafehouse/hardening-denies.sb:$HOME/CODE/dotSafehouse/profiles/cmux.sb"
export DOTSAFEHOUSE_ENABLE="shell-init,ssh,clipboard,macos-gui"
export DOTSAFEHOUSE_RW="$HOME/.claude:$HOME/CODE/doc:$HOME/CODE/infrastructure:$HOME/scripts"
export DOTSAFEHOUSE_RO="$HOME/CODE/claude-jingles"
export DOTSAFEHOUSE_RO="$DOTSAFEHOUSE_RO:$HOME/Library/Caches/node"
export DOTSAFEHOUSE_RW="$DOTSAFEHOUSE_RW:$HOME/.local/state/herdr-core:$HOME/.config/herdr-app:$HOME/.config/herdr-core"
export DOTSAFEHOUSE_RO="$DOTSAFEHOUSE_RO:$HOME/.local/share/herdr-core"

# Briefing injected into Claude's system prompt by safe-claude so the agent
# knows it is sandboxed and routes refusals through the bv-ORCHESTRATE-sandbox-handoff
# skill instead of retrying or improvising. Keep it short — every token here
# rides in every safe-claude session forever. Avoid backticks / apostrophes
# so the string stays safe inside double quotes.
export DOTSAFEHOUSE_CLAUDE_BRIEFING="You are running under agent-safehouse via the safe-claude wrapper. Some paths, sockets, and hosts are denied by policy. Active grants live in ~/CODE/dotSafehouse/shell/safehouse.env (DOTSAFEHOUSE_RW, DOTSAFEHOUSE_RO, DOTSAFEHOUSE_ENABLE). On EPERM, EACCES, or sandbox-deny errors, do not retry or improvise — invoke the bv-ORCHESTRATE-sandbox-handoff skill."

export SAFEHOUSE_ENV_PASS="CMUX_WORKSPACE_ID,CMUX_SURFACE_ID,CMUX_TAB_ID,CMUX_SOCKET_PATH,CMUX_SOCKET_PASSWORD"
export DOTSAFEHOUSE_RO="$DOTSAFEHOUSE_RO:$HOME/Applications/cmux.app"
# Read-only: the CLI only reads the socket path. Connecting is granted by profiles/cmux.sb.
# RW would let the agent delete or replace cmux.sock.
export DOTSAFEHOUSE_RO="$DOTSAFEHOUSE_RO:$HOME/Library/Application Support/cmux"

# gh reads ~/.config/gh, which hardening-denies.sb blocks (token lives there).
# Point gh at an empty dir: local gh stack commands work, auth calls fail → handoff.
# GIT_TERMINAL_PROMPT=0 makes a blocked fetch fail fast instead of hanging on a prompt.
export GH_CONFIG_DIR="$HOME/.config/gh-safehouse"
export GIT_TERMINAL_PROMPT=0
export DOTSAFEHOUSE_RW="$DOTSAFEHOUSE_RW:$GH_CONFIG_DIR"
export SAFEHOUSE_ENV_PASS="$SAFEHOUSE_ENV_PASS,GH_CONFIG_DIR,GIT_TERMINAL_PROMPT"
