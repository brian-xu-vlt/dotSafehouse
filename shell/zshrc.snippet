# dotSafehouse aliases (managed by install.sh — edit the template, not here).
# Runs agents under eugene1g/agent-safehouse with the feature set chosen for
# the inato-marketplace workflow, plus an extra deny layer for SSH keys,
# cloud creds, Keychains, Slack, and 1Password app state.

export DOTSAFEHOUSE_APPEND="$HOME/.config/dotSafehouse/hardening-denies.sb"
export DOTSAFEHOUSE_ENABLE="shell-init,ssh,docker,clipboard"

safe-claude() {
  command safehouse \
    --enable="$DOTSAFEHOUSE_ENABLE" \
    --append-profile "$DOTSAFEHOUSE_APPEND" \
    -- "$HOME/.local/bin/claude" "$@"
}

safe-codex() {
  command safehouse \
    --enable="$DOTSAFEHOUSE_ENABLE" \
    --append-profile "$DOTSAFEHOUSE_APPEND" \
    -- "$(command -v codex)" "$@"
}

safe-shell() {
  command safehouse \
    --enable="$DOTSAFEHOUSE_ENABLE" \
    --append-profile "$DOTSAFEHOUSE_APPEND" \
    -- /bin/zsh -l "$@"
}

alias safe-logs='/usr/bin/log stream --style compact --predicate '\''eventMessage CONTAINS "Sandbox:" AND eventMessage CONTAINS "deny("'\'''
