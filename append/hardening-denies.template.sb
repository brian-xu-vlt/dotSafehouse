;; ---------------------------------------------------------------------------
;; dotSafehouse hardening denies (appended via `safehouse --append-profile`)
;; Rendered from hardening-denies.template.sb by install.sh; __HOME__ is
;; substituted with $HOME at install time so the same template works on any
;; machine.
;;
;; These denies are last in the composed policy -> last-match-wins guarantees
;; they hold even if a future Safehouse module re-opens these paths.
;; Most of them are already deny-by-default; the file documents intent and
;; guards against upstream drift.
;; ---------------------------------------------------------------------------

;; SSH private keys / PEM material
(deny file-read* file-write*
    (regex #"^__HOME__/\.ssh/id_")
    (regex #"^__HOME__/\.ssh/.*\.pem$"))

;; Cloud credentials (AWS, GCP, Azure, DigitalOcean, Databricks)
(deny file-read* file-write*
    (subpath "__HOME__/.aws")
    (subpath "__HOME__/.config/gcloud")
    (subpath "__HOME__/.azure")
    (subpath "__HOME__/.config/doctl")
    (subpath "__HOME__/.databricks"))

;; Kubernetes / Helm — prevents kubectl/helm/helmfile/myke from reaching
;; staging or prod clusters from inside the sandbox.
(deny file-read* file-write*
    (subpath "__HOME__/.kube")
    (subpath "__HOME__/.helm"))

;; Terraform state / Terraform Cloud tokens
(deny file-read* file-write*
    (subpath "__HOME__/.terraform.d"))

;; Git forge tokens — blocks gh CLI, git credential helpers, netrc.
;; Side effect: `gh` and HTTPS `git push` are both unusable under the sandbox.
(deny file-read* file-write*
    (subpath "__HOME__/.config/gh")
    (subpath "__HOME__/.config/git")
    (literal "__HOME__/.netrc"))

;; macOS Keychains (intentional: codex/claude keychain-backed auth disabled)
(deny file-read* file-write*
    (subpath "__HOME__/Library/Keychains"))

;; Persistence vectors — prevent the agent from installing autostart items.
(deny file-read* file-write*
    (subpath "__HOME__/Library/LaunchAgents")
    (subpath "__HOME__/Library/LoginItems"))

;; Messaging / password-manager app state
(deny file-read* file-write*
    (subpath "__HOME__/Library/Application Support/Slack")
    (subpath "__HOME__/Library/Application Support/1Password"))
